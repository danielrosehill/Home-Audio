# home-audio profile. KEY=value; every key optional. Comments are instructions the skills follow.
# Copied to <overlay>/profile.env by the setup skill.

# Primary backend: music-assistant | lms | snapcast
HOME_AUDIO_BACKEND=music-assistant
# LAN to scan in inventory (CIDR, /22 or smaller)
HOME_AUDIO_SUBNET=192.168.1.0/24

# Music Assistant base URL (port 8095 assumed if omitted)
HOME_AUDIO_MA_URL=
# NAME of the env var holding the MA long-lived token (not the token). Default MA_TOKEN
HOME_AUDIO_MA_TOKEN_VAR=MA_TOKEN

# Lyrion/LMS, or MA's Squeezelite provider, for JSON-RPC (host[:9000])
HOME_AUDIO_LMS=
# snapserver for JSON-RPC (host[:1780])
HOME_AUDIO_SNAPSERVER=

# Home Assistant base URL, and NAME of the env var holding its long-lived token. Default HA_TOKEN
HOME_AUDIO_HA_URL=
HOME_AUDIO_HA_TOKEN_VAR=HA_TOKEN

# SSH user for endpoints when the SSH config has no entry
HOME_AUDIO_SSH_USER=

# How secrets reach a process (instruction, e.g. "wrap audioctl in: <your secrets wrapper>"):
